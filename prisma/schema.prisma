  entityId   String   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("content_audit_logs")
}

model OfflineSyncLog {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  clientMutationId String              @unique @map("client_mutation_id")
  entityType       String              @map("entity_type")
  operationType    String              @map("operation_type")
  status           SyncOperationStatus
  conflictDetail   Json?               @map("conflict_detail")
  clientTimestamp  DateTime            @map("client_timestamp")
  processedAt      DateTime            @default(now()) @map("processed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, processedAt])
  @@map("offline_sync_logs")
}

model ContentImportJob {
  id           String          @id @default(uuid()) @db.Uuid
  createdById  String          @map("created_by_id") @db.Uuid
  entityType   String          @map("entity_type")
  fileName     String          @map("file_name")
  status       ImportJobStatus @default(PENDING)
  totalRows    Int             @default(0) @map("total_rows")
  importedRows Int             @default(0) @map("imported_rows")
  errorReport  Json?           @map("error_report")
  startedAt    DateTime        @default(now()) @map("started_at")
  completedAt  DateTime?       @map("completed_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, startedAt])
  @@map("content_import_jobs")
}

// ============================================================================
// 10. ZERO-TO-CHINESE FOUNDATION: CONCEPTS, ADAPTIVE MASTERY & RADICALS
// ============================================================================

model LearningConcept {
  id                   String        @id @default(uuid()) @db.Uuid
  code                 String        @unique
  stageNumber          Int           @map("stage_number")
  pillar               String        // PINYIN | TONES | STROKES | RADICALS | VOCAB_GRAMMAR | SENTENCES
  titleVi              String        @map("title_vi")
  explanationVi        String        @map("explanation_vi") @db.Text
  simpleExplanationVi  String        @map("simple_explanation_vi") @db.Text
  extraExamples        Json?         @map("extra_examples")
  remediationQuestion  Json?         @map("remediation_question")
  lessonId             String?       @map("lesson_id") @db.Uuid
  prerequisiteLessonId String?       @map("prerequisite_lesson_id") @db.Uuid
  status               ContentStatus @default(PUBLISHED)
  origin               ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  lesson             Lesson?               @relation("LessonConcepts", fields: [lessonId], references: [id], onDelete: SetNull)
  prerequisiteLesson Lesson?               @relation("ConceptPrerequisiteLesson", fields: [prerequisiteLessonId], references: [id], onDelete: SetNull)
  questions          Question[]
  masteries          UserConceptMastery[]
  bookmarks          UserConceptBookmark[]

  @@index([stageNumber, pillar])
  @@map("learning_concepts")
}

model UserConceptMastery {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  conceptId         String    @map("concept_id") @db.Uuid
  masteryScore      Float     @default(0) @map("mastery_score")
  attemptsCount     Int       @default(0) @map("attempts_count")
  correctCount      Int       @default(0) @map("correct_count")
  consecutiveMisses Int       @default(0) @map("consecutive_misses")
  needsRemediation  Boolean   @default(false) @map("needs_remediation")
  lastReviewedAt    DateTime? @map("last_reviewed_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept LearningConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, needsRemediation])
  @@map("user_concept_masteries")
}

model UserConceptBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  conceptId String   @map("concept_id") @db.Uuid
  noteVi    String?  @map("note_vi")
  createdAt DateTime @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept LearningConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@map("user_concept_bookmarks")
}

model RadicalComponent {
  id                String            @id @default(uuid()) @db.Uuid
  symbol            String            @unique
  variants          Json              @default("[]")
  pinyin            String
  nameVi            String            @map("name_vi")
  meaningVi         String            @map("meaning_vi")
  roleType          ComponentRoleType @default(SEMANTIC) @map("role_type")
  categoryVi        String            @map("category_vi") // Con người | Thiên nhiên | Đời sống
  commonPositionVi  String            @map("common_position_vi")
  recognitionTipVi  String            @map("recognition_tip_vi") @db.Text
  exampleCharacters Json              @map("example_characters")
  sortOrder         Int               @default(0) @map("sort_order")
  status            ContentStatus     @default(PUBLISHED)
  origin            ContentOrigin     @default(VERIFIED_ORIGINAL)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([categoryVi, sortOrder])
  @@map("radical_components")
}
