generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum RoleCode {
  ADMIN
  CONTENT_EDITOR
  LEARNER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentOrigin {
  VERIFIED_ORIGINAL
  OFFICIAL_LICENSED
  DEMO
  AI_GENERATED
}

enum CurriculumFramework {
  HSK_2_0
  HSK_3_0
  FOUNDATIONS
  BUSINESS
  ACADEMIC
  CUSTOM
}

enum LessonSectionType {
  OBJECTIVES
  VOCABULARY
  GRAMMAR
  LISTENING
  SPEAKING
  READING
  WRITING
  ASSESSMENT
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum SkillType {
  LISTENING
  SPEAKING
  READING
  WRITING
  VOCABULARY
  GRAMMAR
  PRONUNCIATION
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
  SENTENCE_ORDERING
  MATCHING
  LISTENING_COMPREHENSION
  TRANSLATION
  WRITING_SHORT
  WRITING_ESSAY
  AUDIO_DISCRIMINATION
  SYLLABLE_BUILDER
  STROKE_ORDER_SEQUENCE
  RADICAL_MATCHING
}

enum ComponentRoleType {
  SEMANTIC
  PHONETIC
  BOTH
  STRUCTURAL
}

enum ExamType {
  FULL_MOCK
  LISTENING_PRACTICE
  READING_PRACTICE
  WRITING_PRACTICE
  VOCABULARY_PRACTICE
  GRAMMAR_PRACTICE
  CUSTOM
  PLACEMENT
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

enum FlashcardSourceType {
  VOCABULARY
  GRAMMAR
  EXAMPLE_SENTENCE
  INCORRECT_EXERCISE
  LESSON_CONCEPT
  MANUAL
}

enum FsrsCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum AiConversationMode {
  TUTOR_QA
  VOCAB_EXPLAIN
  GRAMMAR_EXPLAIN
  SENTENCE_CORRECTION
  TOPIC_CONVERSATION
  WRITING_COACH
}

enum WritingTaskType {
  CHARACTER_PRACTICE
  VOCABULARY_WRITING
  SENTENCE_CONSTRUCTION
  PARAGRAPH_WRITING
  TRANSLATION
  FREE_WRITING
}

enum MediaType {
  AUDIO
  IMAGE
  DOCUMENT
  STROKE_DATA
}

enum SyncOperationStatus {
  APPLIED
  CONFLICT_RESOLVED
  REJECTED
  FAILED
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  IMPORTING
  COMPLETED
  FAILED
}

// ============================================================================
// 1. AUTHENTICATION & USER SETTINGS
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  settings              UserSetting?
  userRoles             UserRole[]
  courseProgress        UserCourseProgress[]
  lessonProgress        UserLessonProgress[]
  exerciseAttempts      UserExerciseAttempt[]
  vocabularyProgress    UserVocabularyProgress[]
  skillStats            UserSkillStat[]
  studySessions         StudySession[]
  flashcardDecks        FlashcardDeck[]
  flashcards            Flashcard[]
  flashcardReviews      FlashcardReview[]
  examAttempts          ExamAttempt[]
  aiConversations       AiConversation[]
  writingSubmissions    WritingSubmission[]
  pronunciationAttempts PronunciationAttempt[]
  notifications         Notification[]
  auditLogs             ContentAuditLog[]
  offlineSyncLogs       OfflineSyncLog[]
  importJobs            ContentImportJob[]
  uploadedMedia         MediaAsset[]
  conceptMasteries      UserConceptMastery[]
  conceptBookmarks      UserConceptBookmark[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserProfile {
  id                         String    @id @default(uuid()) @db.Uuid
  userId                     String    @unique @map("user_id") @db.Uuid
  displayName                String    @map("display_name")
  avatarUrl                  String?   @map("avatar_url")
  nativeLanguage             String    @default("vi") @map("native_language")
  currentCurriculumVersionId String?   @map("current_curriculum_version_id") @db.Uuid
  currentLevelId             String?   @map("current_level_id") @db.Uuid
  targetLevelId              String?   @map("target_level_id") @db.Uuid
  dailyGoalMinutes           Int       @default(30) @map("daily_goal_minutes")
  streakDays                 Int       @default(0) @map("streak_days")
  longestStreakDays          Int       @default(0) @map("longest_streak_days")
  lastStudyDate              DateTime? @map("last_study_date") @db.Date
  placementCompletedAt       DateTime? @map("placement_completed_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCurriculumVersion CurriculumVersion? @relation(fields: [currentCurriculumVersionId], references: [id], onDelete: SetNull)
  currentLevel             LearningLevel?     @relation("UserCurrentLevel", fields: [currentLevelId], references: [id], onDelete: SetNull)
  targetLevel              LearningLevel?     @relation("UserTargetLevel", fields: [targetLevelId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserSetting {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  theme                  String   @default("system")
  uiLanguage             String   @default("vi") @map("ui_language")
  showPinyinByDefault    Boolean  @default(true) @map("show_pinyin_by_default")
  showTranslationDefault Boolean  @default(true) @map("show_translation_default")
  toneColoringEnabled    Boolean  @default(false) @map("tone_coloring_enabled")
  audioPlaybackSpeed     Float    @default(1.0) @map("audio_playback_speed")
  dailyFlashcardLimit    Int      @default(40) @map("daily_flashcard_limit")
  autoGenerateFlashcards Boolean  @default(true) @map("auto_generate_flashcards")
  offlineAutoSync        Boolean  @default(true) @map("offline_auto_sync")
  emailNotifications     Boolean  @default(false) @map("email_notifications")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================================================
// 2. VERSIONED CURRICULUM ENGINE
// ============================================================================

model CurriculumVersion {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  name        String
  framework   CurriculumFramework
  versionTag  String              @map("version_tag")
  description String?             @db.Text
  isDefault   Boolean             @default(false) @map("is_default")
  status      ContentStatus       @default(DRAFT)
  origin      ContentOrigin       @default(VERIFIED_ORIGINAL)
  metadata    Json?
  publishedAt DateTime?           @map("published_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  levels        LearningLevel[]
  examTemplates ExamTemplate[]
  userProfiles  UserProfile[]

  @@index([framework, status])
  @@map("curriculum_versions")
}

model LearningLevel {
  id                  String        @id @default(uuid()) @db.Uuid
  curriculumVersionId String        @map("curriculum_version_id") @db.Uuid
  code                String
  titleVi             String        @map("title_vi")
  titleZh             String?       @map("title_zh")
  descriptionVi       String?       @map("description_vi") @db.Text
  objectivesVi        Json?         @map("objectives_vi")
  sortOrder           Int           @map("sort_order")
  cefrEquivalent      String?       @map("cefr_equivalent")
  configMetadata      Json?         @map("config_metadata")
  status              ContentStatus @default(DRAFT)
  origin              ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  courses           Course[]
  examTemplates     ExamTemplate[]
  vocabulary        Vocabulary[]
  grammarPoints     GrammarPoint[]
  currentUsers      UserProfile[]     @relation("UserCurrentLevel")
  targetUsers       UserProfile[]     @relation("UserTargetLevel")

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId, sortOrder])
  @@map("learning_levels")
}

model Course {
  id               String        @id @default(uuid()) @db.Uuid
  learningLevelId  String        @map("learning_level_id") @db.Uuid
  slug             String        @unique
  titleVi          String        @map("title_vi")
  titleZh          String?       @map("title_zh")
  summaryVi        String?       @map("summary_vi") @db.Text
  estimatedMinutes Int           @default(120) @map("estimated_minutes")
  sortOrder        Int           @map("sort_order")
  status           ContentStatus @default(DRAFT)
  origin           ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  learningLevel  LearningLevel        @relation(fields: [learningLevelId], references: [id], onDelete: Cascade)
  modules        Module[]
  courseProgress UserCourseProgress[]

  @@index([learningLevelId, sortOrder])
  @@map("courses")
}

model Module {
  id            String        @id @default(uuid()) @db.Uuid
  courseId      String        @map("course_id") @db.Uuid
  slug          String
  titleVi       String        @map("title_vi")
  titleZh       String?       @map("title_zh")
  descriptionVi String?       @map("description_vi") @db.Text
  sortOrder     Int           @map("sort_order")
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@map("modules")
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  moduleId         String        @map("module_id") @db.Uuid
  slug             String        @unique
  titleVi          String        @map("title_vi")
  titleZh          String?       @map("title_zh")
  subtitleVi       String?       @map("subtitle_vi")
  objectivesVi     Json?         @map("objectives_vi")
  estimatedMinutes Int           @default(25) @map("estimated_minutes")
  sortOrder        Int           @map("sort_order")
  isSkippable      Boolean       @default(true) @map("is_skippable")
  contentVersion   Int           @default(1) @map("content_version")
  status           ContentStatus @default(DRAFT)
  origin           ContentOrigin @default(VERIFIED_ORIGINAL)
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  module             Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sections           LessonSection[]
  prerequisites      LessonPrerequisite[] @relation("LessonRequires")
  requiredBy         LessonPrerequisite[] @relation("LessonRequiredBy")
  resources          LearningResource[]
  lessonVocabulary   LessonVocabulary[]
  lessonGrammar      LessonGrammar[]
  exercises          Exercise[]
  userProgress       UserLessonProgress[]
  writingSubmissions WritingSubmission[]
  concepts           LearningConcept[]    @relation("LessonConcepts")
  prerequisiteFor    LearningConcept[]    @relation("ConceptPrerequisiteLesson")

  @@index([moduleId, sortOrder])
  @@index([status])
  @@map("lessons")
}

model LessonSection {
  id             String            @id @default(uuid()) @db.Uuid
  lessonId       String            @map("lesson_id") @db.Uuid
  sectionType    LessonSectionType @map("section_type")
  titleVi        String            @map("title_vi")
  sortOrder      Int               @map("sort_order")
  contentPayload Json              @map("content_payload")
  audioAssetId   String?           @map("audio_asset_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  audioAsset MediaAsset? @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)

  @@unique([lessonId, sectionType, sortOrder])
  @@index([lessonId, sortOrder])
  @@map("lesson_sections")
}

model LessonPrerequisite {
  lessonId             String  @map("lesson_id") @db.Uuid
  prerequisiteLessonId String  @map("prerequisite_lesson_id") @db.Uuid
  isStrict             Boolean @default(false) @map("is_strict")

  lesson             Lesson @relation("LessonRequires", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisiteLesson Lesson @relation("LessonRequiredBy", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteLessonId])
  @@map("lesson_prerequisites")
}

model LearningResource {
  id           String        @id @default(uuid()) @db.Uuid
  lessonId     String?       @map("lesson_id") @db.Uuid
  titleVi      String        @map("title_vi")
  resourceType String        @map("resource_type")
  url          String?
  mediaAssetId String?       @map("media_asset_id") @db.Uuid
  origin       ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt    DateTime      @default(now()) @map("created_at")

  lesson     Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@map("learning_resources")
}

// ============================================================================
// 3. LANGUAGE KNOWLEDGE BASE
// ============================================================================

model Vocabulary {
  id               String        @id @default(uuid()) @db.Uuid
  learningLevelId  String?       @map("learning_level_id") @db.Uuid
  simplified       String
  traditional      String?
  pinyin           String
  pinyinNumbered   String?       @map("pinyin_numbered")
  partOfSpeech     String?       @map("part_of_speech")
  primaryMeaningVi String        @map("primary_meaning_vi")
  primaryMeaningEn String?       @map("primary_meaning_en")
  commonMistakesVi String?       @map("common_mistakes_vi") @db.Text
  relatedWords     Json?         @map("related_words")
  frequencyRank    Int?          @map("frequency_rank")
  status           ContentStatus @default(DRAFT)
  origin           ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  learningLevel LearningLevel?           @relation(fields: [learningLevelId], references: [id], onDelete: SetNull)
  senses        VocabularySense[]
  examples      VocabularyExample[]
  audios        VocabularyAudio[]
  lessons       LessonVocabulary[]
  characters    VocabularyCharacter[]
  userProgress  UserVocabularyProgress[]

  @@unique([simplified, pinyin])
  @@index([learningLevelId])
  @@index([simplified])
  @@index([pinyinNumbered])
  @@map("vocabulary")
}

model VocabularySense {
  id           String  @id @default(uuid()) @db.Uuid
  vocabularyId String  @map("vocabulary_id") @db.Uuid
  partOfSpeech String? @map("part_of_speech")
  meaningVi    String  @map("meaning_vi")
  meaningEn    String? @map("meaning_en")
  usageNoteVi  String? @map("usage_note_vi") @db.Text
  sortOrder    Int     @default(0) @map("sort_order")

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_senses")
}

model VocabularyExample {
  id            String  @id @default(uuid()) @db.Uuid
  vocabularyId  String  @map("vocabulary_id") @db.Uuid
  sentenceZh    String  @map("sentence_zh")
  pinyin        String
  translationVi String  @map("translation_vi")
  translationEn String? @map("translation_en")
  audioAssetId  String? @map("audio_asset_id") @db.Uuid
  sortOrder     Int     @default(0) @map("sort_order")

  vocabulary Vocabulary  @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  audioAsset MediaAsset? @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)

  @@index([vocabularyId])
  @@map("vocabulary_examples")
}

model VocabularyAudio {
  id           String  @id @default(uuid()) @db.Uuid
  vocabularyId String  @map("vocabulary_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  speakerLabel String? @map("speaker_label")
  speedTag     String  @default("normal") @map("speed_tag")
  isPrimary    Boolean @default(true) @map("is_primary")

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_audio")
}

model LessonVocabulary {
  lessonId     String  @map("lesson_id") @db.Uuid
  vocabularyId String  @map("vocabulary_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  isCore       Boolean @default(true) @map("is_core")

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([lessonId, vocabularyId])
  @@index([vocabularyId])
  @@map("lesson_vocabulary")
}

model GrammarPoint {
  id              String        @id @default(uuid()) @db.Uuid
  learningLevelId String?       @map("learning_level_id") @db.Uuid
  code            String        @unique
  titleVi         String        @map("title_vi")
  patternZh       String        @map("pattern_zh")
  patternPinyin   String?       @map("pattern_pinyin")
  explanationVi   String        @map("explanation_vi") @db.Text
  usageNotesVi    String?       @map("usage_notes_vi") @db.Text
  comparisonsVi   String?       @map("comparisons_vi") @db.Text
  commonErrorsVi  String?       @map("common_errors_vi") @db.Text
  status          ContentStatus @default(DRAFT)
  origin          ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  learningLevel LearningLevel?   @relation(fields: [learningLevelId], references: [id], onDelete: SetNull)
  examples      GrammarExample[]
  lessons       LessonGrammar[]

  @@index([learningLevelId])
  @@map("grammar_points")
}

model GrammarExample {
  id             String  @id @default(uuid()) @db.Uuid
  grammarPointId String  @map("grammar_point_id") @db.Uuid
  sentenceZh     String  @map("sentence_zh")
  pinyin         String
  translationVi  String  @map("translation_vi")
  noteVi         String? @map("note_vi")
  isIncorrect    Boolean @default(false) @map("is_incorrect")
  sortOrder      Int     @default(0) @map("sort_order")

  grammarPoint GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)

  @@index([grammarPointId])
  @@map("grammar_examples")
}

model LessonGrammar {
  lessonId       String @map("lesson_id") @db.Uuid
  grammarPointId String @map("grammar_point_id") @db.Uuid
  sortOrder      Int    @default(0) @map("sort_order")

  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  grammarPoint GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)

  @@id([lessonId, grammarPointId])
  @@index([grammarPointId])
  @@map("lesson_grammar")
}

model Character {
  id            String        @id @default(uuid()) @db.Uuid
  hanzi         String        @unique
  traditional   String?
  pinyin        String
  radical       String?
  strokeCount   Int           @map("stroke_count")
  meaningVi     String        @map("meaning_vi")
  mnemonicVi    String?       @map("mnemonic_vi") @db.Text
  decomposition String?
  origin        ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  strokes    CharacterStroke[]
  vocabulary VocabularyCharacter[]

  @@map("characters")
}

model CharacterStroke {
  id          String  @id @default(uuid()) @db.Uuid
  characterId String  @map("character_id") @db.Uuid
  strokeOrder Int     @map("stroke_order")
  svgPath     String  @map("svg_path") @db.Text
  medianPath  Json?   @map("median_path")
  strokeName  String? @map("stroke_name")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, strokeOrder])
  @@map("character_strokes")
}

model VocabularyCharacter {
  vocabularyId String @map("vocabulary_id") @db.Uuid
  characterId  String @map("character_id") @db.Uuid
  position     Int

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([vocabularyId, characterId, position])
  @@map("vocabulary_characters")
}

// ============================================================================
// 4. EXERCISES & QUESTION BANK
// ============================================================================

model Exercise {
  id             String        @id @default(uuid()) @db.Uuid
  lessonId       String?       @map("lesson_id") @db.Uuid
  titleVi        String        @map("title_vi")
  descriptionVi  String?       @map("description_vi") @db.Text
  skillType      SkillType     @map("skill_type")
  passingPercent Int           @default(70) @map("passing_percent")
  timeLimitSec   Int?          @map("time_limit_sec")
  sortOrder      Int           @default(0) @map("sort_order")
  status         ContentStatus @default(DRAFT)
  origin         ContentOrigin @default(VERIFIED_ORIGINAL)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lesson    Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  UserExerciseAttempt[]

  @@index([lessonId, sortOrder])
