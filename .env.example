# =============================================================================
# HanLearn Environment Configuration
# Copy this file to .env and replace placeholder values before running.
# =============================================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://hanlearn:hanlearn_dev_password@localhost:5432/hanlearn?schema=public"

# Auth.js (generate via: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-secure-32-byte-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Application
NEXT_PUBLIC_APP_NAME="HanLearn"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Media Storage (local | s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# AI Tutor Configuration (Phase 5 — server-only, never exposed to browser)
AI_PROVIDER="openai-compatible"
AI_API_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_DAILY_USER_LIMIT="30"

# Optional Pronunciation Assessment Provider (Phase 5 — leave blank if unused)
PRONUNCIATION_PROVIDER="none"
PRONUNCIATION_API_KEY=""
PRONUNCIATION_REGION=""
